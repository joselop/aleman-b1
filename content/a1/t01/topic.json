      "title": "¿Qué saludo usas?",
      "instructions": "Elige el saludo o la despedida adecuada para cada situación.",
      "items": [
        {
          "q": "Son las 8:00. Llegas a la oficina y ves a tu jefa.",
          "options": [
            "Guten Morgen!",
            "Gute Nacht!",
            "Tschüss!"
          ],
          "answer": 0,
          "explain": "Por la mañana temprano: Guten Morgen."
        },
        {
          "q": "Son las 20:00. Llegas a una cena en casa de un profesor.",
          "options": [
            "Gute Nacht!",
            "Guten Abend!",
            "Bis morgen!"
          ],
          "answer": 1,
          "explain": "Al llegar por la noche se dice Guten Abend. Gute Nacht es solo para despedirse antes de dormir."
        },
        {
          "q": "Te despides de un amigo; lo vuelves a ver mañana.",
          "options": [
            "Auf Wiedersehen!",
            "Guten Tag!",
            "Bis morgen!"
          ],
          "answer": 2,
          "explain": "Bis morgen = hasta mañana. Auf Wiedersehen sería demasiado formal con un amigo."
        },
        {
          "q": "Sales de una consulta médica.",
          "options": [
            "Tschüss!",
            "Auf Wiedersehen!",
            "Hallo!"
          ],
          "answer": 1,
          "explain": "En una situación formal: Auf Wiedersehen."
        },
        {
          "q": "Son las 15:00. Entras en una tienda.",
          "options": [
            "Guten Tag!",
            "Guten Morgen!",
            "Gute Nacht!"
          ],
          "answer": 0,
          "explain": "Durante el día, en situación formal: Guten Tag."
